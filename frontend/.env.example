# Vercel/로컬에서 사용할 백엔드 API base URL.
# 비워두면 frontend/src/App.jsx의 기본값 (http://localhost:8080/api/v1)로 폴백되고,
# 그조차 닿지 않으면 App.jsx 내부 MOCK 데이터로 동작합니다.
#
# 예시:
#   VITE_API_BASE_URL=https://news-api.example.com/api/v1
VITE_API_BASE_URL=

# 소셜 로그인 클라이언트 ID (모두 PUBLIC — 번들에 노출되어도 안전. 클라이언트 SECRET은 백엔드 전용.)
# 미설정 시 해당 버튼 클릭하면 "환경변수 미설정" 안내가 뜨고 다른 프로바이더로 fallback 가능.
#
# Google: https://console.cloud.google.com/apis/credentials → OAuth 2.0 클라이언트 ID (웹 애플리케이션)
VITE_GOOGLE_CLIENT_ID=

# Apple: https://developer.apple.com → Identifiers → Services IDs (Sign in with Apple)
VITE_APPLE_CLIENT_ID=
# 팝업 모드 redirect URI — 보통 배포 도메인 (예: https://frontend-two-murex-37.vercel.app)
VITE_APPLE_REDIRECT_URI=

# Kakao: https://developers.kakao.com → 내 애플리케이션 → JavaScript 키
VITE_KAKAO_APP_KEY=
